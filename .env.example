# Copy to .env and fill in. Do not commit .env.
# Atlas: Drivers tab ? copy full URI; replace <password> with your real password.
# If the password contains @ or other reserved characters, encode them (e.g. @ ? %40).
# The URI must stay ONE line in .env (no line breaks inside the string).
MONGO_URI=mongodb://localhost:27017/products_db
# Example shape (do not commit real credentials):
# MONGO_URI=mongodb+srv://USER:ENCODED_PASSWORD@lab-cluster-xxxxx.dlijgu7.mongodb.net/products_db?retryWrites=true&w=majority&appName=lab-cluster-xxxxx
# Optional: increase for slow cold starts (ms)
# MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
