# Copy to .env and fill in. Do not commit .env.
# The URI must stay ONE line in .env (no line breaks inside the string).
# If the password contains @ or other reserved characters, encode them (e.g. @ → %40).

# MongoDB / AWS DocumentDB (Mongo-compatible)
MONGO_URI=mongodb://localhost:27017/products_db
# DocumentDB example (use real user, URL-encoded password, cluster endpoint from Terraform):
# MONGO_URI=mongodb://appuser:ENCODED_PASSWORD@myproj-dev-docdb.cluster-xxxxx.ap-southeast-1.docdb.amazonaws.com:27017/products_db?retryWrites=false
# TLS for DocumentDB — set path to AWS RDS combined CA bundle (download global-bundle.pem; mount in K8s and set this path)
# MONGO_TLS=true
# DOCUMENTDB_TLS_CA_PATH=/path/to/global-bundle.pem
# Fail startup if DB is unreachable (recommended in production against DocumentDB)
# ALLOW_IN_MEMORY_FALLBACK=false
# MONGO_SERVER_SELECTION_TIMEOUT_MS=45000
# Retry DocumentDB / slow VPC DNS during pod startup (optional)
# MONGO_CONNECT_RETRIES=10
# MONGO_CONNECT_RETRY_DELAY_MS=4000

# dotenv: existing process env wins (Helm / K8s). Override path in containers if needed:
# DOTENV_CONFIG_PATH=/secrets/app.env

# AWS S3 — product images (uses default credential chain: env keys, or IRSA on EKS)
# When unset, uploads use local disk under public/uploads (development).
# S3_BUCKET=your-app-uploads-bucket
# AWS_REGION=ap-southeast-1
# Optional key prefix inside the bucket (no leading/trailing slash)
# S3_KEY_PREFIX=prod

# AWS ElastiCache Redis — shared sessions across load-balanced pods (optional)
# When both are set, express-session stores sessions in Redis.
# REDIS_URL=rediss://:AUTH_TOKEN@master.myproj-redis.xxxxx.cache.amazonaws.com:6379
# SESSION_SECRET=use-a-long-random-string-in-production
# TLS to Redis: use rediss:// in REDIS_URL when transit encryption is enabled
# Behind HTTPS (ALB): you may set secure cookies explicitly
# SESSION_COOKIE_SECURE=true
# SESSION_MAX_AGE_MS=86400000
# REDIS_CONNECT_TIMEOUT_MS=15000
# REDIS_READY_TIMEOUT_MS=15000

# Helm / CI: production inject via helm/app/values.deploy.yaml (envFrom Secret api-runtime-env).
# Repository variables: HELM_VALUES_FILE=helm/app/values.deploy.yaml, SYNC_K8S_RUNTIME_SECRET=true,
# optional RUNTIME_SECRET_NAME. GitHub Secrets: APP_MONGO_URI, APP_SESSION_SECRET, APP_REDIS_URL,
# APP_S3_BUCKET (optional APP_AWS_REGION). See node_deployment.yml.
#
# Prefer Kubernetes Secrets for MONGO_URI, REDIS_URL, SESSION_SECRET; mount DocumentDB CA as a
# Secret volume when using TLS; set DOCUMENTDB_TLS_CA_PATH inside the container.
# EKS S3 access: create an IAM role for the pod (IRSA) with s3:GetObject, s3:PutObject,
# s3:DeleteObject on the uploads bucket; annotate the ServiceAccount in Helm.
