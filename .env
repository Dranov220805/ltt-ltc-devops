# Local development (gitignored). Use this shape so npm start works without VPN/VPC.
# For EKS parity, use the same keys in Kubernetes Secret api-runtime-env (never commit real passwords).

PORT=3000
NODE_ENV=development

# Local Mongo — start one with: docker run -d --name mongo -p 27017:27017 mongo:7
MONGO_URI=mongodb://127.0.0.1:27017/products_db

MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_CONNECT_RETRIES=5
MONGO_CONNECT_RETRY_DELAY_MS=2000

# true: if Mongo is down, app still runs with in-memory data (good for quick UI checks).
ALLOW_IN_MEMORY_FALLBACK=true

# Leave empty to use public/uploads on disk. Set bucket only if you have AWS creds and want real S3 from laptop.
AWS_REGION=ap-southeast-1
S3_BUCKET=
S3_KEY_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Leave empty for local dev (no Redis sessions). Or: docker run -d -p 6379:6379 redis:7-alpine
# then REDIS_URL=redis://127.0.0.1:6379 and set SESSION_SECRET to any long string.
REDIS_URL=
SESSION_SECRET=

# --- Optional: test against AWS from a machine that can reach VPC (VPN/bastion) ---
# MONGO_URI=mongodb://USER:URL_ENCODED_PASSWORD@YOUR_DOCDB_ENDPOINT:27017/products_db?retryWrites=false
# REDIS_URL=redis://YOUR_ELASTICACHE_PRIMARY:6379
# SESSION_SECRET=openssl rand -hex 32
# S3_BUCKET=your-terraform-uploads-bucket
# ALLOW_IN_MEMORY_FALLBACK=false

# DocumentDB TLS (only if enable_tls=true in Terraform)
# MONGO_TLS=true
# DOCUMENTDB_TLS_CA_PATH=C:\path\to\global-bundle.pem
