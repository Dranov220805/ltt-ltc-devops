# Local — gitignored. Same variables work in K8s via Secrets / Helm env (do not commit real passwords).
#
# Map from Terraform (run in ltt-ltc-terraform/envs/dev):
#   AWS_REGION              ← terraform output aws_region
#   S3_BUCKET               ← terraform output s3_uploads_bucket_id
#   MONGO_URI               ← cluster endpoint + master user + URL-encoded password:
#                             terraform output documentdb_endpoint
#                             terraform output -raw documentdb_master_password   (encode ! as %21, etc.)
#                             username from tfvars / console ("Master username"), port usually 27017
#   REDIS_URL               ← terraform output redis_primary_endpoint → redis://HOST:6379
#                             (console "Primary endpoint"; transit encryption off → redis:// not rediss://)
#   SESSION_SECRET          ← not from Terraform — openssl rand -hex 32
#
# DocumentDB & Redis sit in a private VPC: from a laptop you usually get timeout/refused unless VPN/bastion/SG allows your IP.
# S3 works from local if AWS credentials can reach the API (keys below, or aws configure / AWS_PROFILE).
#
# ECONNREFUSED to 10.x.x.x on Mongo/Redis: DNS resolved the cluster hostname to a VPC-private address; nothing on your
# machine is allowed to open those ports (Terraform SGs typically allow only EKS/node SGs). Fix = test from EKS, or use
# the local stack below, or VPN+bastion/SG rule (not recommended long-term).
#
# --- Local dev without AWS Mongo/Redis (comment out AWS MONGO_URI + REDIS_URL + SESSION_SECRET above, uncomment below) ---
# MONGO_URI=mongodb://127.0.0.1:27017/products_db
# REDIS_URL=
# SESSION_SECRET=
# Optional local Redis sessions: docker run -d -p 6379:6379 redis:7-alpine  then REDIS_URL=redis://127.0.0.1:6379

PORT=3000
NODE_ENV=development

# DocumentDB — matches console cluster endpoint + master username; password must be URL-encoded in the URI.
MONGO_URI=mongodb://docdbadmin:J33%21YLLMniGvWdKo@devops-final-dev-docdb.cluster-cpwcygk4wrg6.ap-southeast-1.docdb.amazonaws.com:27017/products_db?retryWrites=false

MONGO_SERVER_SELECTION_TIMEOUT_MS=45000
MONGO_CONNECT_RETRIES=10
MONGO_CONNECT_RETRY_DELAY_MS=4000

# true = app still starts if VPC blocks Mongo (typical from laptop). Set false on EKS once networking is correct.
ALLOW_IN_MEMORY_FALLBACK=true

AWS_REGION=ap-southeast-1
S3_BUCKET=devops-final-dev-uploads-525089404588
S3_KEY_PREFIX=
# For local S3 tests: IAM user with s3:Get/Put/Delete on this bucket, or leave blank if AWS CLI profile is configured.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Matches ElastiCache console primary endpoint (encryption in transit disabled).
REDIS_URL=redis://devops-final-dev-redis.849gif.ng.0001.apse1.cache.amazonaws.com:6379
SESSION_SECRET=60e17de768a17d76e3cdbcc5595301d856ad968900f2de62b2d312675f492ef4
REDIS_CONNECT_TIMEOUT_MS=15000
REDIS_READY_TIMEOUT_MS=20000

# Terraform DocumentDB module default enable_tls=false — enable below if you turned TLS on.
# MONGO_TLS=true
# DOCUMENTDB_TLS_CA_PATH=
